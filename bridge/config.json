{
  "api_base_url": "http://127.0.0.1:8888",
  "api_key_env_vars": ["UNSLOTH_STUDIO_AUTH_TOKEN", "UNSLOTH_API_KEY"],
  "local_model_alias": "Ternary Bonsai 2 27B PTQ1_0",
  "local_model_match": "Ternary Bonsai 2 27B",
  "auto_handoff_enabled": true,
  "max_difficulty_full_handoff": 3,
  "max_default_length": "Medium",
  "model_profile": {
    "name": "Ternary Bonsai 2 27B PTQ1_0",
    "use_for_difficulty": [1, 2, 3],
    "max_default_length": "Medium"
  },
  "max_validation_failures": 2,
  "timeout_seconds": 120.0,
  "max_retries": 2,
  "context_budget_tokens": 16384,
  "excluded_files": [
    ".env",
    ".env.*",
    "credentials",
    "credentials/*",
    "**/.aws",
    "**/.aws/*",
    "**/*.pem",
    "**/*.p12",
    "**/*.pfx",
    "**/.gpg",
    "**/id_rsa",
    "**/id_ed25519",
    "**/.ssh",
    "**/.ssh/*",
    "**/.netrc",
    "**/token",
    "**/secret",
    "**/secrets",
    "**/secret/*",
    "package.json.auth",
    "npmrc",
    "**/private_key",
    "**/private-key",
    "**/private_key.txt",
    "**/private-key.txt"
  ],
  "dry_run": false,
  "log_level": "info"
}
